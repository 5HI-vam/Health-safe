# =============================================================
#  Health-Safe — Root .gitignore
#  Covers: Node/Express backend + Vite/React frontend
# =============================================================

# ─── Dependencies ────────────────────────────────────────────
node_modules/
**/node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ─── Environment Variables ───────────────────────────────────
# Never commit real secrets. Use .env.example as a template.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# ─── Build & Distribution Outputs ───────────────────────────
dist/
**/dist/
dist-ssr/
build/
**/build/
out/

# ─── Vite / Frontend ─────────────────────────────────────────
*.local
frontend/.vite/
frontend/coverage/

# ─── Backend: Uploads & User-Generated Content ───────────────
# Keep the folder structure but not the files inside
backend/uploads/**
!backend/uploads/.gitkeep
backend/uploads/evidence/**
!backend/uploads/evidence/.gitkeep

# ─── Backend: Test & Scratch Files ───────────────────────────
backend/test_*.js
backend/seed_*.js

# ─── Logs ────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Runtime & Cache ─────────────────────────────────────────
.cache/
**/.cache/
.parcel-cache/
.turbo/
.next/
.nuxt/
.vuepress/dist

# ─── Testing ─────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov

# ─── IDEs & Editors ──────────────────────────────────────────
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.sw?

# ─── OS Metadata ─────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── Misc ────────────────────────────────────────────────────
*.tgz
*.zip
*.tar.gz
