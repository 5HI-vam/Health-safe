# =============================================================
#  Health-Safe — Backend .gitignore (Node.js / Express)
# =============================================================

# ─── Dependencies ────────────────────────────────────────────
node_modules/

# ─── Environment Variables ───────────────────────────────────
# Add a .env.example with dummy values for onboarding
.env
.env.*
!.env.example

# ─── Uploads & User-Generated Files ──────────────────────────
uploads/**
!uploads/.gitkeep
uploads/evidence/**
!uploads/evidence/.gitkeep

# ─── Logs ────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Test / Scratch Scripts ──────────────────────────────────
test_*.js
seed_*.js

# ─── Runtime & Cache ─────────────────────────────────────────
.cache/
tmp/
temp/

# ─── IDEs & Editors ──────────────────────────────────────────
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.sw?

# ─── OS Metadata ─────────────────────────────────────────────
.DS_Store
Thumbs.db
